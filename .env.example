# ─────────────────────────── Telegram-бот ───────────────────────────
# Токен от @BotFather. Обязательно.
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Список админов через запятую (ваш Telegram user_id)
ADMIN_IDS=123456789

# ─────────────────────── Юзер-аккаунты (Telethon) ───────────────────
# Берутся на my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Прокси для Telethon (необязательно, но желательно для VDS вне РФ/СНГ)
# Формат: socks5://user:pass@host:port  или  http://user:pass@host:port
PROXY=

# ─────────────────────────────── Сервер ─────────────────────────────
# Скопируйте этот файл в .env и заполните значения.
HOST=127.0.0.1
PORT=8080
# Если WEBHOOK_URL задан — бот работает на вебхуке (нужен HTTPS + nginx).
# Если пусто — используем long polling (удобно для локального запуска).
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-string
# Публичный HTTPS-адрес мини-аппа (Telegram открывает только по HTTPS).
# Если пусто — строится из WEBHOOK_URL + /app/
WEBAPP_URL=

# ──────────────────────────────── БД ────────────────────────────────
# SQLite по умолчанию. Для Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ────────────────────────────── Бэкапы ──────────────────────────────
# Каталог архивов (относительный — от корня проекта) и сколько свежих держать.
# BACKUP_PASSPHRASE шифрует архивы. Пароль храните ВНЕ сервера: рядом с .env
# он сгорит вместе с сервером, а без него шифрованный бэкап не прочитать.
# Пустой пароль — открытые архивы (допустимо, только если шифруется сам диск).
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_PASSPHRASE=

# ─────────────────────── Ключ шифрования сессий ─────────────────────
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: потеря ключа = потеря всех сессий пользователей.
SECRET_KEY=

# ───────────────────────────── Тарифы ───────────────────────────────
# Абонемент на 1 месяц
PRICE_RUB=990
PRICE_STARS=299          # Telegram Stars (XTR)
PRICE_USDT=12            # USDT TRC-20
# Пробный период в днях (0 = выключен)
TRIAL_DAYS=3
# Лимиты бесплатной/пробной версии
MAX_RULES_FREE=3
# Сколько дней до конца подписки отправлять напоминание
RENEW_REMIND_DAYS=3

# ─────────────────── Подарок за подписку на канал ────────────────────
# Канал сервиса: за подписку начисляются дни, один раз на аккаунт.
# Пусто — подарка нет ни в кабинете, ни в боте.
# Годится @имя, имя или ссылка t.me/имя; приватная ссылка t.me/+hash не
# годится — по ней Telegram не отвечает, кто в канале.
# ⚠️ Бот должен быть администратором канала, иначе getChatMember не видит
#    подписчиков и проверка всегда отвечает «не вижу вас в канале».
BONUS_CHANNEL=
BONUS_DAYS=3

# ──────────────────────────── Оплата ────────────────────────────────
# Где какой способ оплаты работает:
#   external — по умолчанию. Внутри Telegram (бот и кабинет) абонемент
#              продаётся только за звёзды, карта и USDT — на странице /pay,
#              которая открывается во внешнем браузере. Правила Telegram
#              (ToS для разработчиков, п. 6.2) требуют продавать цифровые
#              товары внутри Telegram только за Stars.
#   stars    — звёзды и заявка админу, карта и USDT выключены везде.
#   inline   — всё внутри бота, как было раньше. Удобно, но именно этот режим
#              нарушает п. 6.2 и ставит бота под риск блокировки.
PAY_MODE=external
# Адрес страницы оплаты, если она живёт отдельно от бота (например на другом
# домене). Пусто — берётся WEBAPP_URL/WEBHOOK_URL + /pay. Только https://.
EXTERNAL_PAYMENTS_URL=

# ЮKassa (карты, СБП). https://yookassa.ru/my
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot

# USDT TRC-20: кошелёк для приёма платежей
USDT_TRC20_WALLET=
# Ключ TronGrid (необязательно, но повышает лимиты): https://www.trongrid.io/
TRONGRID_API_KEY=
# Подтверждения USDT: >0 — зачислять только подтверждённые переводы, 0 — и свежие
# (быстрее, но перевод могут откатить — для тестовых стендов, не для продакшена)
USDT_MIN_CONFIRMATIONS=1

# ───────────────────────── Очередь доставки ─────────────────────────
# Сколько воркеров разбирают очередь (по одному на аккаунт с запасом)
DELIVERY_WORKERS=4
# Максимум задач в очереди. При переполнении новые отбрасываются с записью
# в журнал — так всплеск не съедает всю память.
DELIVERY_QUEUE_MAXSIZE=2000
# Сколько отправок идут одновременно (суммарно по всем аккаунтам)
SEND_GLOBAL_CONCURRENCY=8
# Минимальная пауза между отправками, сек. Значения ниже 0.5 опасны FloodWait.
SEND_MIN_INTERVAL_SECONDS=1.2
# Сколько раз повторять при ошибке Telegram (0 = только одна попытка)
SEND_RETRY_ATTEMPTS=2
# База экспоненциальной паузы между повторами, сек (2 -> 4 -> 8)
SEND_RETRY_BASE_SECONDS=2.0
# Ждать дольше этого при FloodWait не будем: задача уйдёт в журнал ошибок
FLOOD_WAIT_MAX_SECONDS=900

# ───────────────────────── Логи и прочее ────────────────────────────
LOG_LEVEL=INFO
